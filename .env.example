# Copy to .env and replace this value before starting the container.
# Compose image name: use your Docker Hub repository and version for deployment.
# Deployment example: APP_IMAGE=lyvius2/spring-ai-ops:0.0.1-native
APP_IMAGE=spring-ai-ops:local
CRYPTO_SECRET_KEY=replace-with-a-long-random-secret
SPRING_PROFILES_ACTIVE=docker
APP_BASE_URL=http://localhost:7079
ANALYSIS_RESULT_LANGUAGE=ko
# Native runtime memory options are command arguments, e.g. -Xmx1g (not JAVA_OPTS).

# External Redis: replace with a hostname reachable from the container.
SPRING_DATA_REDIS_HOST=redis.example.com
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=
SPRING_DATA_REDIS_SSL_ENABLED=false

# Set credentials for the AI providers you use.
AI_OPEN_AI_API_KEY=
AI_ANTHROPIC_API_KEY=
AI_DEEP_SEEK_API_KEY=
AI_EXAONE_API_KEY=
AWS_BEDROCK_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Optional integrations: use addresses reachable from inside the container.
LOKI_URL=
PROMETHEUS_URL=
GITHUB_ACCESS_TOKEN=
GITLAB_ACCESS_TOKEN=
